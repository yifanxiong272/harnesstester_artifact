    "source_roots": [
      "src",
      "packages",
      "apps",
      "webview-ui"
    ],
    "augment": {
      "test_packages": [
        {
          "name": "extension",
          "cwd": "src",
          "config": "vitest.config.ts",
          "coverageProvider": "istanbul"
        },
        {
          "name": "cli",
          "cwd": "apps/cli",
          "config": "vitest.config.ts",
          "coverageProvider": "istanbul"
        },
        {
          "name": "web-app",
          "cwd": "apps/web-roo-code",
          "config": "vitest.config.ts",
          "coverageProvider": "istanbul"
        },
        {
          "name": "build",
          "cwd": "packages/build",
          "config": "vitest.config.ts",
          "coverageProvider": "istanbul"
        },
        {
          "name": "core",
          "cwd": "packages/core",
          "config": "vitest.config.ts",
          "coverageProvider": "istanbul"
        },
        {
          "name": "types",
          "cwd": "packages/types",
          "config": "vitest.config.ts",
          "coverageProvider": "istanbul"
        },
        {
          "name": "vscode-shim",
          "cwd": "packages/vscode-shim",
          "config": "vitest.config.ts",
          "coverageProvider": "istanbul"
        },
        {
          "name": "webview",
          "cwd": "webview-ui",
          "config": "vitest.config.ts",
          "coverageProvider": "istanbul"
        }
      ]
    },
    "probe": {
      "test_command": [
        "pnpm",
        "exec",
        "vitest",
        "run",
        "--root",
        "src",
        "--configLoader=bundle",
        "<generated-test-file>"
